<script>
/* ============================================================
   CENTRE PERFORMANCE LAB — STATIC MQTT DASHBOARD
   ============================================================
   IMPORTANT:
   Your MQTT broker must expose a WebSocket listener.
   Example Mosquitto config:

   listener 1883
   protocol mqtt

   listener 9001
   protocol websockets

   Then set MQTT_URL below to:
   ws://YOUR_COMPUTER_IP:9001

   For HTTPS hosting, use WSS instead:
   wss://YOUR_DOMAIN:9001
   ============================================================ */

const CONFIG = {
  MQTT_URL: "ws://192.168.1.100:9001",
  MQTT_USERNAME: "",
  MQTT_PASSWORD: "",
  TOPIC_ROOT: "centre/athletes",
  ATHLETE_ID: "001",
  MAX_POINTS: 300
};

let mqttClient = null;
let packetHistory = [];
let maxVelocity = 0;
let maxAcceleration = 0;
let maxDeceleration = 0;

const $ = id => document.getElementById(id);
const fmt = (n,d=2) => Number.isFinite(Number(n)) ? Number(n).toFixed(d) : "0.00";

function chartOptions(yTitle){
  return {
    responsive:true, maintainAspectRatio:false, animation:false,
    interaction:{mode:"index",intersect:false},
    plugins:{legend:{display:true,labels:{color:"#9aa6b5",boxWidth:10,font:{size:10}}}},
    scales:{
      x:{ticks:{color:"#687483",maxTicksLimit:8},grid:{color:"#1d2732"}},
      y:{ticks:{color:"#687483"},grid:{color:"#1d2732"},title:{display:true,text:yTitle,color:"#7f8b99"}}
    }
  };
}
const velocityChart = new Chart($("velocityChart"),{
  type:"line",data:{labels:[],datasets:[{label:"Velocity",data:[],borderColor:"#62d5ff",backgroundColor:"rgba(98,213,255,.08)",fill:true,tension:.25,pointRadius:0}]},
  options:chartOptions("m/s")
});
const accelChart = new Chart($("accelChart"),{
  type:"line",data:{labels:[],datasets:[{label:"Acceleration",data:[],borderColor:"#54e39a",tension:.25,pointRadius:0}]},
  options:chartOptions("m/s²")
});
const distanceChart = new Chart($("distanceChart"),{
  type:"line",data:{labels:[],datasets:[{label:"Velocity",data:[],borderColor:"#a78bfa",tension:.25,pointRadius:0}]},
  options:chartOptions("m/s")
});
const imuChart = new Chart($("imuChart"),{
  type:"line",data:{labels:[],datasets:[
    {label:"X",data:[],borderColor:"#62d5ff",tension:.2,pointRadius:0},
    {label:"Y",data:[],borderColor:"#54e39a",tension:.2,pointRadius:0},
    {label:"Z",data:[],borderColor:"#ffd166",tension:.2,pointRadius:0}
  ]},
  options:chartOptions("m/s²")
});

function connectMQTT(){
  $("connection").textContent = "CONNECTING…";
  mqttClient = mqtt.connect(CONFIG.MQTT_URL,{
    username:CONFIG.MQTT_USERNAME || undefined,
    password:CONFIG.MQTT_PASSWORD || undefined,
    clientId:"centre-dashboard-"+Math.random().toString(16).slice(2),
    clean:true,
    reconnectPeriod:3000,
    connectTimeout:8000
  });

  mqttClient.on("connect",()=>{
    $("dot").classList.add("online");
    $("connection").textContent = "MQTT ONLINE";
    const topic = `${CONFIG.TOPIC_ROOT}/${CONFIG.ATHLETE_ID}/#`;
    mqttClient.subscribe(topic,{qos:0});
  });

  mqttClient.on("reconnect",()=>{
    $("dot").classList.remove("online");
    $("connection").textContent = "RECONNECTING…";
  });

  mqttClient.on("offline",()=>{
    $("dot").classList.remove("online");
    $("connection").textContent = "MQTT OFFLINE";
  });

  mqttClient.on("error",(err)=>{
    console.error("MQTT:",err);
    $("dot").classList.remove("online");
    $("connection").textContent = "MQTT ERROR";
  });

  mqttClient.on("message",(topic,payload)=>{
    try{
      const data = JSON.parse(payload.toString());
      handlePacket(data,topic);
    }catch(e){ console.warn("Invalid MQTT JSON",e); }
  });
}

function handlePacket(data,topic){
  if(data.athleteId && data.athleteId !== $("athlete").value) return;

  const t = Number(data.sessionElapsed ?? data.timestamp ?? 0);
  const velocity = Number(data.velocity ?? data.gpsSpeed ?? 0);
  const acceleration = Number(data.acceleration ?? 0);
  const distance = Number(data.distance ?? 0);

  maxVelocity = Math.max(maxVelocity,velocity);
  maxAcceleration = Math.max(maxAcceleration,acceleration);
  if(acceleration < 0) maxDeceleration = Math.min(maxDeceleration,acceleration);

  const packet = {
    ...data,
    t, velocity, acceleration, distance,
    receivedAt:new Date()
  };
  packetHistory.push(packet);
  if(packetHistory.length > CONFIG.MAX_POINTS) packetHistory.shift();

  updateUI(packet);
  updateCharts(packet);
  updateTable(packet);
}

function updateUI(d){
  $("time").innerHTML = `${fmt(d.sessionElapsed)}<span class="kpi-unit">s</span>`;
  $("distance").innerHTML = `${fmt(d.distance)}<span class="kpi-unit">m</span>`;
  $("velocity").innerHTML = `${fmt(d.velocity)}<span class="kpi-unit">m/s</span>`;
  $("maxVelocity").innerHTML = `${fmt(maxVelocity)}<span class="kpi-unit">m/s</span>`;
  $("acceleration").innerHTML = `${fmt(d.acceleration)}<span class="kpi-unit">m/s²</span>`;
  $("deceleration").innerHTML = `${fmt(maxDeceleration)}<span class="kpi-unit">m/s²</span>`;

  $("gpsSpeed").textContent = `${fmt(d.gpsSpeed)} m/s`;
  $("satellites").textContent = d.gpsSatellites ?? 0;
  $("accelMag").textContent = `${fmt(d.acceleration)} m/s²`;
  $("gx").textContent = `${fmt(d.gx)} °/s`;
  $("gy").textContent = `${fmt(d.gy)} °/s`;
  $("gz").textContent = `${fmt(d.gz)} °/s`;
  $("sequence").textContent = d.sequence ?? "—";

  $("summaryEvent").textContent = d.event ?? $("event").value;
  $("summaryAthlete").textContent = d.athleteId ?? $("athlete").value;
  $("summaryMax").textContent = `${fmt(maxVelocity)} m/s`;
  $("summaryAccel").textContent = `${fmt(maxAcceleration)} m/s²`;
  $("lastPacket").textContent = new Date().toLocaleTimeString();

  if(Number(d.latitude) && Number(d.longitude)){
    $("gpsStatus").textContent = `${d.gpsSatellites ?? 0} SAT`;
    $("gpsText").textContent = `${Number(d.latitude).toFixed(6)}, ${Number(d.longitude).toFixed(6)}`;
    // Relative visualization only; replace with a real map later.
    const x = 20 + ((Number(d.longitude)*1000)%60);
    const y = 20 + ((Number(d.latitude)*1000)%60);
    $("gpsDot").style.left = Math.max(5,Math.min(92,x))+"%";
    $("gpsDot").style.top = Math.max(5,Math.min(88,y))+"%";
  }

  $("sessionState").textContent = d.sessionId ? "ACTIVE" : "LIVE";
  $("packetCount").textContent = `${packetHistory.length} packets`;
}

function pushChart(chart,label,value){
  chart.data.labels.push(label);
  if(chart.data.labels.length > CONFIG.MAX_POINTS) chart.data.labels.shift();
  if(Array.isArray(value)){
    value.forEach((v,i)=>{
      chart.data.datasets[i].data.push(v);
      if(chart.data.datasets[i].data.length > CONFIG.MAX_POINTS) chart.data.datasets[i].data.shift();
    });
  }else{
    chart.data.datasets[0].data.push(value);
    if(chart.data.datasets[0].data.length > CONFIG.MAX_POINTS) chart.data.datasets[0].data.shift();
  }
  chart.update("none");
}

function updateCharts(d){
  const label = fmt(d.sessionElapsed,1);
  pushChart(velocityChart,label,d.velocity);
  pushChart(accelChart,label,d.acceleration);
  pushChart(distanceChart,fmt(d.distance,1),d.velocity);
  pushChart(imuChart,label,[Number(d.ax||0),Number(d.ay||0),Number(d.az||0)]);
}

function updateTable(d){
  const tbody = $("packetTable");
  if(tbody.children.length===1 && tbody.children[0].querySelector(".empty")) tbody.innerHTML="";
  const tr = document.createElement("tr");
  tr.innerHTML = `
    <td>${new Date().toLocaleTimeString()}</td>
    <td>${d.sequence ?? "—"}</td>
    <td>${fmt(d.distance)} m</td>
    <td>${fmt(d.velocity)} m/s</td>
    <td>${fmt(d.acceleration)} m/s²</td>
    <td>${Number(d.latitude)?Number(d.latitude).toFixed(5)+", "+Number(d.longitude).toFixed(5):"—"}</td>`;
  tbody.prepend(tr);
  while(tbody.children.length>8) tbody.removeChild(tbody.lastChild);
}

$("event").addEventListener("change",e=>{
  $("summaryEvent").textContent=e.target.value;
});
$("athlete").addEventListener("change",e=>{
  $("summaryAthlete").textContent=e.target.value;
});

connectMQTT();
</script>
</body>
</html>
